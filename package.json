{
  "name": "playable-forge",
  "version": "0.1.0",
  "description": "CLI toolchain to build Meta playable ads from mechanic templates x styles x briefs",
  "type": "module",
  "bin": {
    "playable": "./dist/cli.js"
  },
  "scripts": {
    "playable": "tsx src/cli.ts",
    "forge": "tsx src/cli.ts forge",
    "catalog": "tsx src/assetgen/catalog-doc.ts",
    "check:layouts": "tsx src/assetgen/layouts/lint.ts",
    "menu": "tsx src/assetgen/build-test-playable.ts",
    "experiments": "tsx src/assetgen/build-experiments.ts",
    "recipes": "tsx src/assetgen/build-recipes.ts",
    "game": "tsx src/assetgen/build-game.ts",
    "connect": "tsx src/assetgen/build-connect.ts",
    "fix-the-floor": "tsx src/assetgen/build-fix-the-floor.ts",
    "dream-floor": "tsx src/assetgen/build-dream-floor.ts",
    "financial-foundation": "tsx src/assetgen/build-financial-foundation.ts",
    "components": "tsx src/assetgen/build-components.ts",
    "visual": "tsx src/assetgen/visual-test.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "pipeline:demo": "tsx src/assetgen/pipeline/demo.ts",
    "pipeline:menu": "tsx src/assetgen/pipeline/menu-run.ts",
    "pipeline": "tsx src/assetgen/pipeline/cli.ts",
    "mechanics": "tsx src/assetgen/mechanics.ts",
    "refgames": "tsx src/assetgen/refgames/index.ts",
    "refgames:gen": "tsx src/assetgen/refgames/gen-test.ts",
    "dashboard": "tsx src/assetgen/dashboard.ts",
    "dashboard:deploy": "npm run dashboard && tsx tools/deploy-dashboard.ts",
    "hooks:install": "tsx tools/install-hooks.ts",
    "brief": "tsx src/assetgen/brief/cli.ts",
    "studio": "tsx src/server/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "@imgly/background-removal-node": "^1.4.5",
    "dotenv": "^17.4.2",
    "gsap": "^3.12.5",
    "openai": "^6.39.1",
    "pixi.js": "^8.6.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
